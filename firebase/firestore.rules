rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isOwner(resourcePatientId) {
      return request.auth.uid == resourcePatientId;
    }

    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update, delete: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
    }

    match /patient_records/{recordId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (isAdmin() || resource.data.patientId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.patientId == request.auth.uid);
    }

    match /emergency_cases/{caseId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (isAdmin() || resource.data.patientId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.patientId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /disease_statistics/{statId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    match /voice_records/{recordId} {
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow read: if isAuthenticated() && (isAdmin() || resource.data.patientId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
  }
}
